NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_SCHEMA_VERSION=legacy
DATABASE_URL=postgresql://payguard:payguard@127.0.0.1:55432/payguard
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_KEEPALIVE_INITIAL_DELAY_MS=10000
DATABASE_MAX_USES=5000
DATABASE_MAX_LIFETIME_SECONDS=1800
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
CLAMAV_CHUNK_BYTES=65536
VERIFYET_ENABLED=false
# VERIFYET_BASE_URL=https://provider-contract-host.example/
# VERIFYET_API_KEY=replace-with-a-distinct-managed-secret-at-least-32-characters
VERIFYET_TIMEOUT_MS=8000
VERIFYET_MAX_RESPONSE_BYTES=65536
VERIFYET_MAX_POLL_ATTEMPTS=6
VERIFYET_INITIAL_POLL_DELAY_MS=2000
VERIFYET_MAX_POLL_DELAY_MS=30000
FIREBASE_ENABLED=false
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_TIMEOUT_MS=8000
NOTIFICATION_WORKER_POLL_MS=2000
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCOUNT_ENCRYPTION_KEY=replace-with-a-different-32-character-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=payguard
S3_ACCESS_KEY_ID=payguard
S3_SECRET_ACCESS_KEY=replace-this-local-development-secret
S3_FORCE_PATH_STYLE=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
