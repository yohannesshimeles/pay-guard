{
  "name": "pay-guard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PayGuard modular monolith backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --entryFile worker --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:integration": "jest --config jest.integration.json --runInBand",
    "test:pdf-worker": "jest --config jest.pdf-worker.json --runInBand",
    "test:v2:integration": "jest --config jest.v2-integration.json --runInBand",
    "test:phase9:load": "npm run build && node scripts/phase9-report-load.cjs",
    "test:phase9:archive": "npm run build && node scripts/phase9-archive-exercise.cjs",
    "test:phase9:leakage": "npm run build && node scripts/phase9-leakage-scan.cjs",
    "test:phase9:uploads": "npm run build && node scripts/phase9-upload-security-scan.cjs",
    "test:phase9:rbac": "jest --runInBand test/security/rbac-surface.acceptance.spec.ts",
    "test:phase9:resilience": "jest --runInBand test/verify-et/verify-et-worker.service.spec.ts test/verify-et/verify-et-worker.runner.spec.ts test/verify-et/verify-et-error-mapper.service.spec.ts test/verify-et/verify-et-polling-policy.service.spec.ts test/verify-et/verify-et-webhook-delivery.dao.spec.ts test/verify-et/verify-et-webhook-intake.service.spec.ts test/verify-et/verify-et-request-history.dao.spec.ts test/verify-et/verify-et-operational-alert.dao.spec.ts test/verifications/pending-recheck.dao.spec.ts test/reports/report-export.worker.spec.ts",
    "test:phase9:security": "npm run lint && npm run typecheck && node scripts/phase9-security-scan.cjs && npm run security:audit:production",
    "test:phase10:rate-load": "npm run build && node scripts/phase10-rate-limit-load.cjs",
    "test:phase10:history": "node scripts/phase10-repository-history-scan.cjs",
    "test:phase10:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/phase10-deployment-rollback.ps1",
    "cutover:release-evidence": "node scripts/phase10-release-evidence.cjs",
    "test:phase10:evidence-validator": "node scripts/phase10-release-evidence.cjs test/fixtures/production-release-evidence.valid.json",
    "test:phase10:alerts": "node scripts/phase10-alert-rules.cjs",
    "test:phase10:alerts:promtool": "node scripts/phase10-promtool.cjs",
    "test:phase10:linux-native": "node scripts/phase10-linux-native.cjs",
    "test:phase10:ci-supply-chain": "node scripts/phase10-ci-supply-chain.cjs",
    "test:phase10:container-contract": "node scripts/phase10-container-contract.cjs",
    "test:phase10:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/phase10-independent-startup.ps1",
    "test:api-docs": "jest --runInBand test/documentation/postman-collection.spec.ts",
    "docs:export": "npm run build && node --env-file=.env dist/documentation/export-api-docs.js",
    "docs:check": "npm run build && node --env-file=.env dist/documentation/export-api-docs.js --check",
    "test:database:prepare": "node scripts/prepare-test-database.cjs",
    "test:v2:database:prepare": "node scripts/prepare-test-database.cjs",
    "bootstrap:admin": "node --env-file=.env scripts/bootstrap-admin.cjs",
    "rotate:admin-password": "node --env-file=.env scripts/rotate-admin-password.cjs",
    "migration:up": "node dist/database/migrate.js --command up",
    "migration:up:dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/database/migrate.ts --command up",
    "migration:status:dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/database/migrate.ts --command status",
    "migration:down:dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/database/migrate.ts --command down",
    "migration:v2:up:dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/database/migrate.ts --command up --dir database/initial",
    "migration:v2:status:dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/database/migrate.ts --command status --dir database/initial",
    "cutover:v2:preflight": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/database/v2-cutover-preflight.ts",
    "security:audit:production": "npm audit --omit=dev --audit-level=high",
    "migration:create": "tsx src/database/create-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "^10.1.3",
    "@napi-rs/canvas": "0.1.80",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.29",
    "@nestjs/swagger": "^11.2.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.6.1",
    "jsqr": "1.4.0",
    "pdfjs-dist": "5.4.394",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.3",
    "zod": "^4.0.10"
  },
  "overrides": {
    "@fastify/ajv-compiler": {
      "fast-uri": "3.1.5"
    },
    "@nestjs/platform-fastify": {
      "find-my-way": "9.7.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.2.2"
    },
    "ajv": {
      "fast-uri": "3.1.5"
    },
    "fast-json-stringify": {
      "fast-uri": "4.1.2"
    },
    "fastify": {
      "find-my-way": "9.7.0"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "js-yaml": "5.2.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
